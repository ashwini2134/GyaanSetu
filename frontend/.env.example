# Backend API base URL (defaults to /api via Vite dev proxy)
VITE_API_URL=/api

# Backend origin for OAuth redirects (must match backend port — do not use the Vite proxy)
VITE_BACKEND_URL=http://localhost:3001

# Certs app public URL (for certificate verify/download links)
VITE_CERTS_APP_URL=https://your-certs-app.vercel.app
