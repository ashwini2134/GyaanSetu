// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  output     = "../generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// ── Core Identity ────────────────────────────────────────────────────────────

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  name           String
  passwordHash   String
  createdAt      DateTime @default(now())

  // Unified Gamification & Stats
  totalXp        Int      @default(0)
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActiveAt   DateTime @default(now())

  // Relational Links
  progress       Progress[]
  quizAttempts   QuizAttempt[]
  submissions    Submission[]
  projects       Project[]
  achievements   Achievement[]
  xpHistory      XpTransaction[]
  chatMessages   ChatMessage[]
}

// ── Course Engagement ────────────────────────────────────────────────────────

model Progress {
  id           String   @id @default(uuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  courseSlug   String   // e.g. "cs50-ai"
  lectureId    String   // Identifies the specific section/lecture
  status       String   // e.g. "STARTED", "COMPLETED"
  completedAt  DateTime?
  
  @@unique([userId, courseSlug, lectureId])
}

model QuizAttempt {
  id           String   @id @default(uuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  quizId       String   // Identifies which quiz
  score        Int
  total        Int
  passed       Boolean
  answers      Json     // Stores the specific answers chosen by the student
  createdAt    DateTime @default(now())
}

// ── Practice & Code Submissions ──────────────────────────────────────────────

model Submission {
  id           String   @id @default(uuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  problemId    String   // Identifies the practice problem
  code         String   @db.Text
  status       String   // e.g. "DRAFT", "SUBMITTED", "PASSED"
  updatedAt    DateTime @updatedAt
  
  @@unique([userId, problemId])
}

model ChatMessage {
  id           String   @id @default(uuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  problemId    String
  role         String   // "user" or "assistant"
  content      String   @db.Text
  createdAt    DateTime @default(now())
}

model Project {
  id           String   @id @default(uuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  projectId    String
  code         String   @db.Text
  status       String   // e.g. "DRAFT", "COMPLETED"
  completedAt  DateTime?
  updatedAt    DateTime @updatedAt
  
  @@unique([userId, projectId])
}

// ── Gamification Engine ──────────────────────────────────────────────────────

model Achievement {
  id             String   @id @default(uuid())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  achievementId  String   // Identifies the unlocked badge
  unlockedAt     DateTime @default(now())
  
  @@unique([userId, achievementId])
}

model XpTransaction {
  id           String   @id @default(uuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  amount       Int
  reason       String
  actionId     String?  // Optional: Used to uniquely identify an action so XP isn't awarded twice
  createdAt    DateTime @default(now())

  @@unique([userId, actionId]) // Prisma ignores nulls in Postgres unique constraints
}
