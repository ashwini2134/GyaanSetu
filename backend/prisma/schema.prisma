generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                @id @default(uuid())
  email               String                @unique
  name                String
  passwordHash        String?
  createdAt           DateTime              @default(now())
  totalXp             Int                   @default(0)
  currentStreak       Int                   @default(0)
  longestStreak       Int                   @default(0)
  lastActiveAt        DateTime              @default(now())
  emailVerified       Boolean               @default(false)
  role                String                @default("student")
  statsData           Json?
  overallProgress     Int                   @default(0)
  updatedAt           DateTime              @updatedAt
  bio                 String                @default("")
  avatarUrl           String                @default("")
  notificationPrefs   Json?
  achievements        Achievement[]
  chatMessages        ChatMessage[]
  codeDrafts          CodeDraft[]
  dailyMissions       DailyMission[]
  issuedCertificates  IssuedCertificate[]
  lectureProgress     LectureProgress[]
  oauthAccounts       OAuthAccount[]
  oauthExchangeCodes  OAuthExchangeCode[]
  passwordResetTokens PasswordResetToken[]
  practiceSubmissions PracticeSubmission[]
  progress            Progress[]
  projects            Project[]
  projectFiles        ProjectFile[]
  taskProgress        ProjectTaskProgress[]
  quizAttempts        QuizAttempt[]
  refreshTokens       RefreshToken[]
  submissions         Submission[]
  xpHistory           XpTransaction[]
  assessmentProgress  AssessmentProgress[]
  notifications       InAppNotification[]
}

model InAppNotification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  link      String    @default("")
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("in_app_notifications")
}

model Progress {
  id                String    @id @default(uuid())
  userId            String
  courseSlug        String
  lectureId         String
  status            String
  completedAt       DateTime?
  practiceAttempted Boolean   @default(false)
  practiceCompleted Boolean   @default(false)
  projectCompleted  Boolean   @default(false)
  projectId         String?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseSlug, lectureId])
}

model LectureProgress {
  id           String   @id @default(uuid())
  userId       String
  courseSlug   String
  lectureId    String
  sectionIndex Int
  isCompleted  Boolean  @default(false)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseSlug, lectureId, sectionIndex])
}

model QuizAttempt {
  id            String   @id @default(uuid())
  userId        String
  quizId        String
  score         Float
  total         Int?
  passed        Boolean
  answers       Json
  attemptNumber Int      @default(1)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Submission {
  id        String   @id @default(uuid())
  userId    String
  problemId String
  code      String
  status    String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  problemId String
  role      String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id           String                @id @default(uuid())
  userId       String
  projectId    String
  code         String
  status       String
  completedAt  DateTime?
  updatedAt    DateTime              @updatedAt
  description  String?
  githubUrl    String?
  liveDemoUrl  String?
  startedAt    DateTime?
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskProgress ProjectTaskProgress[]

  @@unique([userId, projectId])
}

model ProjectFile {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  fileId    String
  content   String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId, fileId])
}

model ProjectTaskProgress {
  id          String    @id @default(uuid())
  userId      String
  projectId   String
  taskId      String
  status      String    @default("NOT_STARTED")
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project   @relation(fields: [userId, projectId], references: [userId, projectId], onDelete: Cascade)

  @@unique([userId, projectId, taskId])
}

model ProjectTemplate {
  id                String   @id
  title             String
  category          String
  difficulty        String
  shortDescription  String
  longDescription   String
  technologies      String[]
  features          String[]
  instructions      String[]
  expectedOutput    String
  estimatedDuration String?
  prerequisites     String[]
  learningOutcomes  String[]
  image             String?
  githubLink        String?
  demoLink          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Achievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model XpTransaction {
  id        String   @id @default(uuid())
  userId    String
  amount    Int
  reason    String
  actionId  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, actionId])
}

model OAuthAccount {
  id             String   @id @default(uuid())
  userId         String
  provider       String
  providerUserId String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OAuthExchangeCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CodeDraft {
  id        String   @id @default(uuid())
  userId    String
  lectureId String
  type      String
  code      String
  language  String   @default("python")
  savedAt   DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lectureId, type])
}

model DailyMission {
  id          String    @id @default(uuid())
  userId      String
  date        String
  missions    Json
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model PracticeSubmission {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  lectureId String
  prompt    String
  response  String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, lectureId])
}

model PracticeExercise {
  id                 String   @id @default(uuid())
  courseId           String
  lectureId          String
  sectionId          String?
  title              String
  type               String
  status             String   @default("published")
  learningGoal       String
  challenge          String
  promptHint         String
  validationRules    Json
  completionCriteria Json
  difficulty         String   @default("beginner")
  estimatedTime      Int      @default(5)
  aiWorkspaceEnabled Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([courseId, lectureId, sectionId, type])
  @@map("practice_exercises")
}

model AssessmentQuestion {
  id            String   @id @default(cuid())
  category      String
  subsection    String
  type          String
  question      String
  options       String[]
  correctAnswer String
  starterCode   String?
  language      String?
  difficulty    String   @default("medium")
  createdAt     DateTime @default(now())

  @@map("assessment_questions")
}

model AssessmentProgress {
  id             String   @id @default(uuid())
  userId         String
  category       String
  subsection     String
  score          Int
  totalQuestions Int
  timeTaken      Int
  status         String
  attempts       Int      @default(1)
  lastAttemptAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, subsection])
  @@map("assessment_progress")
}

model IssuedCertificate {
  id         String   @id @default(uuid())
  userId     String
  courseSlug String
  certNumber String   @unique
  issuedAt   DateTime @default(now())
  issuedBy   String
  avgScore   Float?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseSlug])
}

model Course {
  id               String          @id @default(cuid())
  title            String
  description      String
  thumbnailUrl     String?
  category         String
  difficulty       String
  estimatedDuration Int
  status           String          @default("DRAFT")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  lessons          Lesson[]
  quiz             Quiz?
  project          CourseProject?
  versions         CourseVersion[]
  betaTesters      BetaTester[]
  betaFeedback     BetaFeedback[]
  prerequisites    Course[]        @relation("CoursePrerequisites")
  requiredBy       Course[]        @relation("CoursePrerequisites")
}

model Lesson {
  id        String     @id @default(cuid())
  courseId  String
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  content   String?
  videoUrl  String?
  order     Int
  type      String     @default("content")
  exercises Exercise[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Exercise {
  id              String   @id @default(cuid())
  lessonId        String
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type            String
  question        String
  options         Json?
  correctAnswer   String?
  hints           Json?
  attemptsAllowed Int      @default(3)
  points          Int      @default(10)
  createdAt       DateTime @default(now())
}

model Quiz {
  id          String         @id @default(cuid())
  courseId    String         @unique
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  passScore   Int            @default(70)
  timeLimit   Int            @default(0)
  maxAttempts Int            @default(3)
  shuffle     Boolean        @default(false)
  questions   QuizQuestion[]
}

model QuizQuestion {
  id            String   @id @default(cuid())
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  type          String
  question      String
  options       Json?
  correctAnswer String?
  points        Int      @default(10)
  order         Int
}

model CourseProject {
  id               String   @id @default(cuid())
  courseId         String   @unique
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title            String
  requirements     String
  submissionType   String
  rubric           Json?
  validationRules  Json?
  isCapstone       Boolean  @default(false)
  learningObjectives Json?
}

model CourseVersion {
  id            String   @id @default(cuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  versionNumber Int
  snapshot      Json
  changelog     String?
  createdAt     DateTime @default(now())
}

model BetaTester {
  courseId String
  userId   String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  @@id([courseId, userId])
}

model BetaFeedback {
  id           String   @id @default(cuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId       String
  lessonId     String?
  feedbackText String
  isReviewed   Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model StudentProgress {
  id              String   @id @default(cuid())
  studentId       String
  courseId        String
  lessonId        String
  completed       Boolean  @default(false)
  completedAt     DateTime?
  @@unique([studentId, lessonId])
}

model ProjectSubmission {
  id          String   @id @default(cuid())
  studentId   String
  projectId   String
  content     String?
  fileUrl     String?
  githubUrl   String?
  status      String   @default("PENDING")
  score       Float?
  feedback    String?
  aiReview    Json?
  submittedAt DateTime @default(now())
  reviewedAt  DateTime?
}

model Certificate {
  id             String   @id @default(cuid())
  studentId      String
  courseId       String
  verificationId String   @unique @default(cuid())
  pdfUrl         String
  issuedAt       DateTime @default(now())
}

model StudentPortfolio {
  id           String   @id @default(cuid())
  studentId    String   @unique
  courses      Json     @default("[]")
  certificates Json     @default("[]")
  projects     Json     @default("[]")
  updatedAt    DateTime @updatedAt
}
