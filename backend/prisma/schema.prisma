generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                @id @default(uuid())
  email               String                @unique
  name                String
  passwordHash        String
  createdAt           DateTime              @default(now())
  totalXp             Int                   @default(0)
  currentStreak       Int                   @default(0)
  longestStreak       Int                   @default(0)
  lastActiveAt        DateTime              @default(now())
  emailVerified       Boolean               @default(false)
  role                String                @default("student")
  statsData           Json?
  overallProgress     Int                   @default(0)
  updatedAt           DateTime              @updatedAt
  bio                 String                @default("")
  avatarUrl           String                @default("")
  notificationPrefs   Json?
  githubUrl           String                @default("")
  linkedinUrl         String                @default("")
  portfolioUrl        String                @default("")
  status              String                @default("active")
  profileVisibility   String                @default("public")
  profileTheme        String                @default("default")
  portfolioTemplate   String                @default("bento")
  streakFreezeCount   Int                   @default(0)
  streakFreezeUsedAt  DateTime?
  achievements        Achievement[]
  chatMessages        ChatMessage[]
  codeDrafts          CodeDraft[]
  dailyMissions       DailyMission[]
  issuedCertificates  IssuedCertificate[]
  lectureProgress     LectureProgress[]
  oauthAccounts       OAuthAccount[]
  oauthExchangeCodes  OAuthExchangeCode[]
  passwordResetTokens PasswordResetToken[]
  practiceSubmissions PracticeSubmission[]
  progress            Progress[]
  tryItEngagements    TryItEngagement[]
  projects            Project[]
  projectFiles        ProjectFile[]
  taskProgress        ProjectTaskProgress[]
  quizAttempts        QuizAttempt[]
  refreshTokens       RefreshToken[]
  submissions         Submission[]
  xpHistory           XpTransaction[]
  weeklyXp            WeeklyXp[]
  assessmentProgress  AssessmentProgress[]
  certificates        Certificate[]
  notifications       InAppNotification[]
  practiceAttempts    PracticeAttempt[]
  projectSubmissions  ProjectSubmission[]
  reviewQueue         ReviewQueue[]
  createdCodes        InviteCode[]          @relation("CreatedCodes")
  redeemedCodes       RedeemedCode[]
  omiMappings         OmiUserMapping[]
}

model InAppNotification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  link      String    @default("")
  readAt    DateTime?
  createdAt DateTime  @default(now())
  category  String    @default("general")
  priority  String    @default("normal")
  dedupeKey String?   @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("in_app_notifications")
}

model Progress {
  id                String    @id @default(uuid())
  userId            String
  courseSlug        String
  lectureId         String
  status            String
  completedAt       DateTime?
  practiceAttempted Boolean   @default(false)
  practiceCompleted Boolean   @default(false)
  projectCompleted  Boolean   @default(false)
  projectId         String?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseSlug, lectureId])
}

model LectureProgress {
  id           String   @id @default(uuid())
  userId       String
  courseSlug   String
  lectureId    String
  sectionIndex Int
  isCompleted  Boolean  @default(false)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseSlug, lectureId, sectionIndex])
}

// Cumulative time spent with a "Try It Yourself" code block expanded —
// feeds the certification-grading engagement check (a block counts as
// "done" once secondsSpent crosses a threshold, see certificationService.ts).
model TryItEngagement {
  id           String   @id @default(cuid())
  userId       String
  courseSlug   String
  lectureId    String
  blockId      String
  secondsSpent Int      @default(0)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseSlug, lectureId, blockId])
}

model QuizAttempt {
  id            String   @id @default(cuid())
  userId        String
  score         Float
  passed        Boolean
  answers       Json
  createdAt     DateTime @default(now())
  courseId      String?
  lectureId     String?
  feedback      Json?
  timeTaken     Int?
  attemptNumber Int?     @default(1)
  quizId        String?
  total         Int?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Submission {
  id         String   @id @default(uuid())
  userId     String
  problemId  String
  code       String
  status     String
  difficulty String?
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  problemId String
  role      String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id                 String                @id @default(uuid())
  userId             String
  projectId          String
  code               String
  status             String
  completedAt        DateTime?
  updatedAt          DateTime              @updatedAt
  description        String?
  githubUrl          String?
  liveDemoUrl        String?
  startedAt          DateTime?
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskProgress       ProjectTaskProgress[]
  projectSubmissions ProjectSubmission[]

  @@unique([userId, projectId])
}

model ProjectFile {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  fileId    String
  content   String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId, fileId])
}

model ProjectTaskProgress {
  id          String    @id @default(uuid())
  userId      String
  projectId   String
  taskId      String
  status      String    @default("NOT_STARTED")
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project   @relation(fields: [userId, projectId], references: [userId, projectId], onDelete: Cascade)

  @@unique([userId, projectId, taskId])
}

model ProjectTemplate {
  id                String   @id
  title             String
  category          String
  difficulty        String
  shortDescription  String
  longDescription   String
  technologies      String[]
  features          String[]
  instructions      String[]
  expectedOutput    String
  estimatedDuration String?
  prerequisites     String[]
  learningOutcomes  String[]
  image             String?
  githubLink        String?
  demoLink          String?
  downloadUrl       String?
  guidelines        Json?
  evaluationChecklist Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Achievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())
  custom        Boolean  @default(false)
  icon          String?
  description   String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model XpTransaction {
  id        String   @id @default(uuid())
  userId    String
  amount    Int
  reason    String
  actionId  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, actionId])
}

model WeeklyXp {
  id          String   @id @default(uuid())
  userId      String
  weekStart   DateTime
  weekEnd     DateTime
  weekNumber  Int
  totalXp     Int      @default(0)
  rank        Int?
  activities  Int      @default(0)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@index([userId])
  @@index([weekStart])
  @@map("weekly_xp")
}

model OAuthAccount {
  id             String   @id @default(uuid())
  userId         String
  provider       String
  providerUserId String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OAuthExchangeCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CodeDraft {
  id        String   @id @default(uuid())
  userId    String
  lectureId String
  type      String
  code      String
  language  String   @default("python")
  savedAt   DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lectureId, type])
}

model DailyMission {
  id          String    @id @default(uuid())
  userId      String
  date        String
  missions    Json
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model PracticeSubmission {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  lectureId String
  prompt    String
  response  String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, lectureId])
}

model AssessmentQuestion {
  id            String      @id @default(cuid())
  assessmentId  String?
  category      String
  subsection    String
  type          String
  question      String
  options       String[]
  correctAnswer String
  starterCode   String?
  language      String?
  difficulty    String      @default("medium")
  createdAt     DateTime    @default(now())
  assessment    Assessment? @relation(fields: [assessmentId], references: [id])

  @@map("assessment_questions")
}

model Assessment {
  id          String               @id @default(cuid())
  title       String
  category    String
  subsection  String
  description String?
  isPublished Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  questions   AssessmentQuestion[]

  @@map("assessments")
}

model AssessmentProgress {
  id             String   @id @default(uuid())
  userId         String
  category       String
  subsection     String
  score          Int
  totalQuestions Int
  timeTaken      Int
  status         String
  attempts       Int      @default(1)
  lastAttemptAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, subsection])
  @@map("assessment_progress")
}

model IssuedCertificate {
  id           String    @id @default(uuid())
  userId       String
  courseSlug   String
  certNumber   String    @unique
  issuedAt     DateTime  @default(now())
  issuedBy     String
  avgScore     Float?
  status       String    @default("active")
  revokeReason String?
  revokedAt    DateTime?
  templateId   String    @default("default")
  viewCount    Int       @default(0)
  shareCount   Int       @default(0)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseSlug])
}

model ReviewQueue {
  id          String    @id @default(uuid())
  itemType    String
  itemId      String
  userId      String?
  priority    String
  status      String
  title       String
  description String    @default("")
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resolvedAt  DateTime?
  resolvedBy  String?
  notes       String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, priority])
  @@index([itemType, status])
  @@index([userId])
  @@map("review_queue")
}

model PracticeExercise {
  id                       String            @id @default(uuid())
  courseId                 String
  lectureId                String
  sectionId                String?
  title                    String
  type                     String
  status                   String            @default("draft")
  learningGoal             String
  challenge                String
  promptHint               String
  validationRules          Json              @default("[]")
  completionCriteria       Json              @default("[]")
  difficulty               String            @default("beginner")
  estimatedTime            Int?
  aiWorkspaceEnabled       Boolean           @default(false)
  systemInstruction        String?
  suggestedPrompt          String?
  aiResponseEvalCriteria   Json              @default("[]")
  reflectionRequirements   Json              @default("[]")
  aiCompletionRequirements Json              @default("[]")
  starterCode              String?
  expectedOutput           String?
  testCases                Json              @default("[]")
  inputValues              String?
  hints                    Json              @default("[]")
  solutionCode             String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  attempts                 PracticeAttempt[]

  @@unique([courseId, lectureId, sectionId, type])
  @@map("practice_exercises")
}

model PracticeAttempt {
  id            String           @id @default(uuid())
  exerciseId    String
  userId        String
  passed        Boolean
  hintUsed      Boolean          @default(false)
  timeSpent     Int?
  failureReason String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  exercise      PracticeExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([exerciseId])
  @@index([userId])
  @@map("practice_attempts")
}

model ProjectSubmission {
  id              String        @id @default(cuid())
  projectId       String
  content         String?
  githubUrl       String
  score           Int?
  feedback        String?
  createdAt       DateTime      @default(now())
  reviewSteps     Json?
  updatedAt       DateTime      @updatedAt
  userId          String
  status          ProjectStatus @default(PENDING)
  aiReview        Json?
  attemptNumber   Int           @default(1)
  courseId        String?
  maxScore        Int?
  securityCheck   Json?
  studentId       String?
  submissionType  String        @default("text")
  validationCheck Json?
  isFlagged       Boolean       @default(false)
  isOverridden    Boolean       @default(false)
  overriddenAt    DateTime?
  overriddenBy    String?
  overrideReason  String?
  project         Project       @relation(fields: [projectId], references: [id])
  user            User          @relation(fields: [userId], references: [id])

  @@map("project_submissions")
}

model Certificate {
  id             String   @id @default(cuid())
  studentId      String
  courseId       String
  verificationId String   @unique @default(cuid())
  pdfUrl         String
  issuedAt       DateTime @default(now())
  enrolledAt     DateTime @default(now())
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("certificates")
}

model StudentPortfolio {
  id           String   @id @default(cuid())
  studentId    String   @unique
  courses      Json     @default("[]")
  certificates Json     @default("[]")
  projects     Json     @default("[]")
  skills       Json     @default("[]")
  screenshots  Json     @default("[]")
  experience   Json     @default("[]")
  education    Json     @default("[]")
  services     Json     @default("[]")
  testimonials Json     @default("[]")
  updatedAt    DateTime @updatedAt

  @@map("student_portfolios")
}

model Course {
  id                String          @id @default(cuid())
  title             String
  description       String
  thumbnailUrl      String?
  category          String
  difficulty        String
  estimatedDuration Int
  status            String          @default("DRAFT")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  betaFeedback      BetaFeedback[]
  betaTesters       BetaTester[]
  project           CourseProject?
  versions          CourseVersion[]
  lessons           Lesson[]
  quiz              Quiz?
  certificates      Certificate[]
  Course_A          Course[]        @relation("CoursePrerequisites")
  Course_B          Course[]        @relation("CoursePrerequisites")
}

model Lesson {
  id        String     @id @default(cuid())
  courseId  String
  title     String
  content   String?
  videoUrl  String?
  order     Int
  type      String     @default("content")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  exercises Exercise[]
  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Exercise {
  id              String   @id @default(cuid())
  lessonId        String
  type            String
  question        String
  options         Json?
  correctAnswer   String?
  hints           Json?
  attemptsAllowed Int      @default(3)
  points          Int      @default(10)
  createdAt       DateTime @default(now())
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Quiz {
  id          String         @id @default(cuid())
  courseId    String         @unique
  passScore   Int            @default(70)
  timeLimit   Int            @default(0)
  maxAttempts Int            @default(3)
  shuffle     Boolean        @default(false)
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions   QuizQuestion[]
}

model QuizQuestion {
  id            String  @id @default(cuid())
  quizId        String
  type          String
  question      String
  options       Json?
  correctAnswer String?
  points        Int     @default(10)
  order         Int
  quiz          Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model CourseProject {
  id                 String  @id @default(cuid())
  courseId           String  @unique
  title              String
  requirements       String
  submissionType     String
  rubric             Json?
  validationRules    Json?
  isCapstone         Boolean @default(false)
  learningObjectives Json?
  course             Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseVersion {
  id            String   @id @default(cuid())
  courseId      String
  versionNumber Int
  snapshot      Json
  changelog     String?
  createdAt     DateTime @default(now())
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model BetaTester {
  courseId String
  userId   String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([courseId, userId])
}

model BetaFeedback {
  id           String   @id @default(cuid())
  courseId     String
  userId       String
  lessonId     String?
  feedbackText String
  isReviewed   Boolean  @default(false)
  createdAt    DateTime @default(now())
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model StudentProgress {
  id          String    @id @default(cuid())
  studentId   String
  courseId    String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?

  @@unique([studentId, lessonId])
}

model BrandingSettings {
  id             String   @id @default(cuid())
  platformName   String   @default("Fraylon Academy")
  tagline        String   @default("Learn. Build. Grow.")
  primaryColor   String   @default("#4F46E5")
  secondaryColor String   @default("#0F1117")
  logoUrl        String?
  faviconUrl     String?
  updatedAt      DateTime @updatedAt
}

model AIConfiguration {
  id                   String   @id @default(cuid())
  provider             String   @default("google")
  apiKey               String?
  model                String   @default("gemini-2.0-flash")
  strictnessLevel      String   @default("balanced")
  passScoreRegular     Int      @default(70)
  passScoreCapstone    Int      @default(80)
  maxAttemptsRegular   Int      @default(3)
  maxAttemptsCapstone  Int      @default(2)
  securityCheckEnabled Boolean  @default(true)
  validationEnabled    Boolean  @default(true)
  aiReviewEnabled      Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

model EmailTemplate {
  id           String   @id @default(cuid())
  templateKey  String   @unique
  name         String
  trigger      String
  subject      String
  body         String
  variables    Json
  isCustomized Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}

model RoleChangeHistory {
  id          String   @id @default(cuid())
  userId      String
  changedById String
  fromRole    String
  toRole      String
  createdAt   DateTime @default(now())
}

model WebhookEndpoint {
  id         String            @id @default(cuid())
  url        String
  events     Json
  secretKey  String?
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id           String          @id @default(cuid())
  webhookId    String
  event        String
  payload      Json
  status       String
  responseCode Int?
  createdAt    DateTime        @default(now())
  webhook      WebhookEndpoint @relation(fields: [webhookId], references: [id])
}

enum ProjectStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
  ERROR
  CANCELLED
  NEEDS_REVIEW
}

model InviteCode {
  id          String   @id @default(cuid())
  code        String   @unique
  createdBy   String
  createdAt   DateTime @default(now())
  expiresAt   DateTime?
  maxUses     Int?
  
  creator     User     @relation("CreatedCodes", fields: [createdBy], references: [id], onDelete: Cascade)
  redemptions RedeemedCode[]
  
  @@map("invite_codes")
}

model RedeemedCode {
  id           String     @id @default(cuid())
  userId       String
  inviteCodeId String
  redeemedAt   DateTime   @default(now())
  
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  inviteCode   InviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Cascade)
  
  @@unique([userId, inviteCodeId])
  @@map("redeemed_codes")
}

model OmiUserMapping {
  id        String   @id @default(uuid())
  userId    String
  omiUid    String   @unique
  linkedAt  DateTime @default(now())
  isActive  Boolean  @default(true)
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, omiUid])
  @@index([omiUid])
  @@index([userId])
  @@map("omi_user_mappings")
}
