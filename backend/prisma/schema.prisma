generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  name                String
  passwordHash        String
  createdAt           DateTime             @default(now())
  totalXp             Int                  @default(0)
  currentStreak       Int                  @default(0)
  longestStreak       Int                  @default(0)
  lastActiveAt        DateTime             @default(now())
  emailVerified       Boolean              @default(false)
  avatarUrl           String               @default("")
  role                String               @default("student")
  statsData           Json?
  notificationPrefs   Json?
  overallProgress     Int                  @default(0)
  updatedAt           DateTime             @updatedAt
  bio                 String               @default("")
  achievements        Achievement[]
  chatMessages        ChatMessage[]
  codeDrafts          CodeDraft[]
  dailyMissions       DailyMission[]
  oauthAccounts       OAuthAccount[]
  oauthExchangeCodes  OAuthExchangeCode[]
  passwordResetTokens PasswordResetToken[]
  progress            Progress[]
  lectureProgress     LectureProgress[]
  projects            Project[]
  quizAttempts        QuizAttempt[]
  assessmentProgress  AssessmentProgress[]
  refreshTokens       RefreshToken[]
  submissions         Submission[]
  practiceSubmissions PracticeSubmission[]
  xpHistory           XpTransaction[]
  projectFiles        ProjectFile[]
  taskProgress        ProjectTaskProgress[]
  notifications       InAppNotification[]
  issuedCertificates  IssuedCertificate[]
}

model InAppNotification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  link      String   @default("")
  readAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("in_app_notifications")
}

model Progress {
  id                String    @id @default(uuid())
  userId            String
  courseSlug        String
  lectureId         String
  status            String
  completedAt       DateTime?
  practiceAttempted Boolean   @default(false)
  practiceCompleted Boolean   @default(false)
  projectCompleted  Boolean   @default(false)
  projectId         String?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseSlug, lectureId])
}

model LectureProgress {
  id           String   @id @default(uuid())
  userId       String
  courseSlug   String
  lectureId    String
  sectionIndex Int      
  isCompleted  Boolean  @default(false)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseSlug, lectureId, sectionIndex])
}

model QuizAttempt {
  id        String   @id @default(uuid())
  userId    String
  quizId    String
  score     Int
  total     Int
  passed    Boolean
  answers   Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Submission {
  id        String   @id @default(uuid())
  userId    String
  problemId String
  code      String
  status    String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  problemId String
  role      String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id          String    @id @default(uuid())
  userId      String
  projectId   String
  code        String
  status      String
  startedAt   DateTime?
  completedAt DateTime?
  githubUrl   String?
  liveDemoUrl String?
  description String?
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskProgress ProjectTaskProgress[]

  @@unique([userId, projectId])
}

model ProjectFile {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  fileId    String
  content   String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId, fileId])
}

model ProjectTaskProgress {
  id          String    @id @default(uuid())
  userId      String
  projectId   String
  taskId      String
  status      String    @default("NOT_STARTED")
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project     Project   @relation(fields: [userId, projectId], references: [userId, projectId], onDelete: Cascade)

  @@unique([userId, projectId, taskId])
}

model ProjectTemplate {
  id                String    @id
  title             String
  category          String
  difficulty        String
  shortDescription  String
  longDescription   String
  technologies      String[]
  features          String[]
  instructions      String[]
  expectedOutput    String
  estimatedDuration String?
  prerequisites     String[]
  learningOutcomes  String[]
  image             String?
  githubLink        String?
  demoLink          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Achievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model XpTransaction {
  id        String   @id @default(uuid())
  userId    String
  amount    Int
  reason    String
  actionId  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, actionId])
}

model OAuthAccount {
  id             String   @id @default(uuid())
  userId         String
  provider       String
  providerUserId String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OAuthExchangeCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CodeDraft {
  id        String   @id @default(uuid())
  userId    String
  lectureId String
  type      String
  code      String
  language  String   @default("python")
  savedAt   DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lectureId, type])
}

model DailyMission {
  id          String    @id @default(uuid())
  userId      String
  date        String
  missions    Json
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model PracticeSubmission {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  lectureId String
  prompt    String
  response  String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, lectureId])
}

model AssessmentQuestion {
  id            String   @id @default(cuid())
  category      String
  subsection    String
  type          String   // "mcq" or "coding"
  question      String
  options       String[] // for MCQ only, array of 4 options
  correctAnswer String   // for MCQ: the correct option text. For coding: expected output
  starterCode   String?  // for coding questions only
  language      String?  // for coding: "python", "javascript" etc
  difficulty    String   @default("medium") // "easy", "medium", "hard"
  createdAt     DateTime @default(now())

  @@map("assessment_questions")
}

model AssessmentProgress {
  id             String   @id @default(uuid())
  userId         String
  category       String
  subsection     String
  score          Int
  totalQuestions Int
  timeTaken      Int
  status         String
  attempts       Int      @default(1)
  lastAttemptAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, subsection])
  @@map("assessment_progress")
}

model IssuedCertificate {
  id          String   @id @default(uuid())
  userId      String
  courseSlug  String
  certNumber  String   @unique
  issuedAt    DateTime @default(now())
  issuedBy    String
  avgScore    Float?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseSlug])
}
