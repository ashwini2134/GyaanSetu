# Server
PORT=3001
NODE_ENV=development

# Security — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Frontend URL (for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:5173/LMS

# Database — PostgreSQL connection string (required in production)
DATABASE_URL=postgresql://user:password@localhost:5432/fraylon_lms
DATABASE_PATH=./data/lms.db

# OAuth — GitHub (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/oauth/github/callback

# GitHub personal access token (https://github.com/settings/tokens) — separate
# from the OAuth app credentials above. Used server-side by the AI project
# review pipeline to fetch a student's submitted repo (aiReviewService.ts,
# githubRepoFetcher.ts). Public repo read access ("public_repo" scope) is
# enough. Without this, repo checks go out unauthenticated and hit GitHub's
# public rate limit (60 req/hour, shared across ALL students on this server)
# instead of the authenticated limit (5000 req/hour).
GITHUB_TOKEN=

# OAuth — LinkedIn (https://www.linkedin.com/developers/)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:3001/api/auth/oauth/linkedin/callback

# OAuth — Google (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/oauth/google/callback

# AI — Groq API key for AI-powered features (practice exercise generation, mentor hints)
# Get yours at https://console.groq.com/keys
GROQ_API_KEY=

# Certs App — external certificate issuance and verification service
CERTS_APP_URL=https://your-certs-app.vercel.app
CERTS_BEARER_TOKEN=your-issue-bearer-token-here

# Puppeteer cert-rendering microservice (certs/puppeteer-service) — renders
# the downloadable Fraylon Academy course-completion certificate PDF.
PUPPETEER_SERVICE_URL=http://localhost:8787
PUPPETEER_SERVICE_TOKEN=your-puppeteer-service-bearer-token-here

# Password reset (tokens logged to console in development when unset)
SMTP_FROM=noreply@fraylon.academy

GOOGLE_AI_API_KEY=

# ========================================
# AI Mentor — Fraylon AI Mentor Feature
# ========================================

# Qdrant Vector Database
# Get Qdrant Cloud URL and API key from https://cloud.qdrant.io/
# Or use local instance: http://localhost:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# OpenAI Embeddings (for semantic search in Qdrant)
# Required for embedding course content and learner queries
# Get API key from https://platform.openai.com/api-keys
# Model: text-embedding-3-small (1536 dimensions)
OPENAI_API_KEY=

# Lyzr AI Agent Orchestration
# Get API key from https://studio.lyzr.ai/
# Required for executing AI agent workflows
LYZR_API_KEY=

# Lyzr Workflow Configuration (placeholder - requires manual setup in Lyzr Studio)
# After creating a workflow in Lyzr Studio, copy the workflow ID here
LYZR_WORKFLOW_ID=

# Lyzr Agent Configuration (for Agent Chat API)
# After creating an agent in Lyzr Studio, copy the agent ID here
# This is used for the agent chat API: POST /v3/inference/chat/
LYZR_AGENT_ID=

# Omi Voice/Conversation Capture
# Get API key from https://omi.me/developer
# Note: Omi uses Firebase authentication for live transcription
# The Developer API uses Bearer token authentication
OMI_API_KEY=

# Qdrant Collection Configuration
# Collection name for storing LMS learning memory
# Must match the embedding model dimensions (384 for Xenova/all-MiniLM-L6-v2)
QDRANT_COLLECTION_NAME=lms_learning_memory_384