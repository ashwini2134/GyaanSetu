# Server
PORT=3001
NODE_ENV=development

# Security — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Frontend URL (for CORS and OAuth redirects)
FRONTEND_URL=http://localhost:5173/LMS

# Database
DATABASE_PATH=./data/lms.db

# OAuth — GitHub (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/oauth/github/callback

# OAuth — LinkedIn (https://www.linkedin.com/developers/)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:3001/api/auth/oauth/linkedin/callback

# OAuth — Google (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/oauth/google/callback

# Password reset (tokens logged to console in development when unset)
SMTP_FROM=noreply@fraylon.academy
