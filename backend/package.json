{
  "name": "fraylon-academy-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "(npx --yes prisma db push --accept-data-loss --url=\"$DATABASE_URL\" || echo 'DB Push failed') && node dist/index.js",
    "build": "npx prisma generate && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:assessments": "tsx src/seeds/assessmentQuestions.ts",
    "seed:drag-drop": "tsx src/seeds/dragDropExercises.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/archiver": "^8.0.0",
    "@types/pg": "^8.20.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.79.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "node-cron": "^4.5.0",
    "nodemailer": "^9.0.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "resend": "^6.14.0",
    "sqlite3": "^6.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.13.10",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.2",
    "vitest": "^3.0.8"
  }
}
