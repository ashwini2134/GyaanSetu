{
  "name": "fraylon-academy-backend",
  "private": true,
  "version": "3.0.0",
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "npx prisma migrate deploy && DISABLE_WORKERS=true node dist/index.js",
    "start:web": "DISABLE_WORKERS=true node dist/index.js",
    "start:worker": "node dist/worker.js",
    "build": "npx prisma generate && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:assessments": "tsx src/seeds/assessmentQuestions.ts",
    "seed:drag-drop": "tsx src/seeds/dragDropExercises.ts",
    "seed:ai-mentor": "tsx src/seeds/indexCourseContent.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.109.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@qdrant/js-client-rest": "^1.19.0",
    "@xenova/transformers": "^2.17.2",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.79.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "node-cron": "^4.5.0",
    "nodemailer": "^9.0.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "qrcode": "^1.5.4",
    "resend": "^6.14.0",
    "sqlite3": "^6.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.20.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.2",
    "vitest": "^3.0.8"
  }
}
